[module/killswitch]
type = custom/ipc

hook-0 = sudo /home/baldric/Documents/polybar-internet-killswitch/killswitch --status
hook-1 = sudo /home/baldric/Documents/polybar-internet-killswitch/killswitch --on
hook-2 = sudo /home/baldric/Documents/polybar-internet-killswitch/killswitch --off
initial = 1
click-left = #killswitch.hook.1
click-right = #killswitch.hook.2

format-foreground = ${colors.yellow}
format-prefix = "%{T1}ks "
label = %{T2}%output%

