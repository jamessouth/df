[module/tv]
type = custom/ipc

hook-0 = xrandr --output eDP-1 --auto --output HDMI-1 --off; echo ' '
hook-1 = xrandr --output HDMI-1 --mode 1360x768 --pos 3x0 --output eDP-1 --off; echo '󱄄 '
hook-2 = xrandr --output eDP-1 --auto --output HDMI-1 --mode 1360x768 --pos 3x0; echo ' '
initial = 1
click-left = #tv.next
click-right = #tv.prev

format-foreground = ${colors.cyan}
format-prefix = "%{T1}tv "
label = %{T2}%output%

