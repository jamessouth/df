[module/nightlight]
type = custom/ipc

label = %{T3}%output%
format-foreground = ${colors.blue}
format-prefix = "%{T1}nl "

hook-0 = echo "0" > /dev/shm/nightlight && echo "" 
hook-1 = ~/.config/polybar/scripts/nightlight -
hook-2 = ~/.config/polybar/scripts/nightlight +

initial = 0
scroll-up = "#nightlight.hook.1"
scroll-down = "#nightlight.hook.2"

