[bar/topbar]
width = 100%
height = 20
fixed-center = true
background = ${colors.base03}
module-margin-right = 4
padding-left = 1
padding-right = 1

font-0 = ManufacturingConsent:style=Regular:size=18;2
font-1 = BinaryClock:style=BoldMono:size=15;4
font-2 = FiraCode Nerd Font Mono:style=Regular:size=18;4
font-3 = UnifrakturCook:style=Bold:size=16;3
font-4 = Limelight:style=Regular:size=21;6

modules-left = battery filesystem pulseaudio backlight nightlight updates
modules-center = bspwm 
modules-right = menu memory cpu date time

enable-ipc = true
wm-name = polybarT
wm-restack = bspwm
override-redirect = true
cursor-click = pointer


