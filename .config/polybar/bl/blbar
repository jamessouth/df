[bar/blbar]
width = 50%
height = 20
fixed-center = true
background = ${colors.blue}
;module-margin-right = 4
padding-left = 1
padding-right = 1

font-0 = ManufacturingConsent:style=Regular:size=18;2
font-1 = FiraCode Nerd Font Mono:style=Regular:size=18;4
font-2 = FiraCode Nerd Font Mono:style=Regular:size=13;3
font-3 = DejaVu Sans:size=11;2
font-4 = Zen Antique:size=11;2

modules-left = menu
modules-center = wallpaper

enable-ipc = true
wm-name = polybarBl
wm-restack = bspwm
override-redirect = true
;cursor-click = pointer

bottom = true
line-size = 1

