[module/menu]
type = custom/menu

expand-right = false
format-spacing = 0

label-open = "%{T3}"
label-open-foreground = ${colors.orange}

label-close = "%{T3}"
label-close-foreground = ${colors.orange}

label-separator = "%{T3}|"
label-separator-foreground = ${colors.base00}

menu-0-0 = "%{T3}⟳"
menu-0-0-foreground = ${colors.orange}
menu-0-0-exec = reboot

menu-0-1 = "%{T3}⏻"
menu-0-1-foreground = ${colors.orange}
menu-0-1-exec = shutdown now

